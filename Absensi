<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Absensi Karyawan</title>
    <style>
        body { font-family: sans-serif; max-width: 400px; margin: 40px auto; padding: 20px; background-color: #f9f9f9; }
        .container { background-color: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        label, select, input, button { display: block; width: 100%; margin-bottom: 10px; }
        input, select { padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        
        button { padding: 12px; background-color: #004791; color: white; border: none; cursor: pointer; border-radius: 4px; font-weight: bold; }
        button:hover { background-color: #003366; }
        #btnCapture { background-color: #ff751f; margin-bottom: 20px; }
        #btnCapture:hover { background-color: #e66819; }
        
        #video-container { text-align: center; margin-bottom: 15px; }
        video { width: 100%; border-radius: 4px; border: 1px solid #ccc; background-color: #000; }
        canvas { display: none; }
        img#preview { display: none; width: 100%; border-radius: 4px; border: 1px solid #ccc; margin-bottom: 15px; }
        
        .status-box { font-size: 0.9em; padding: 10px; margin-bottom: 15px; border-radius: 4px; background-color: #eef; border: 1px solid #ccd; }
        #notifikasi { margin-top: 15px; font-weight: bold; text-align: center; }
    </style>
</head>
<body>

    <div class="container">
        <h2>Form Absensi</h2>
        <form id="formAbsen">
            
            <label for="tipeAbsen">Tipe Absen:</label>
            <select id="tipeAbsen" required>
                <option value="Masuk">Absen Masuk</option>
                <option value="Pulang">Absen Pulang</option>
            </select>

            <label for="nama">Nama Lengkap:</label>
            <input type="text" id="nama" required>

            <label for="status">Status Kehadiran:</label>
            <select id="status">
                <option value="Hadir">Hadir</option>
                <option value="Sakit">Sakit</option>
                <option value="Izin">Izin</option>
            </select>

            <label>Lokasi GPS:</label>
            <div class="status-box" id="lokasiStatus">Mencari lokasi... Pastikan GPS aktif.</div>
            <input type="hidden" id="gpsData">

            <label>Selfie Bukti Kehadiran:</label>
            <div id="video-container">
                <video id="camera" autoplay playsinline></video>
            </div>
            <img id="preview" alt="Hasil Foto">
            <input type="hidden" id="fotoData">
            
            <button type="button" id="btnCapture">Ambil Foto</button>

            <button type="submit" id="btnSubmit" disabled>Kirim Absen (Tunggu GPS & Foto)</button>
        </form>

        <div id="notifikasi"></div>
    </div>

    <script>
        // URL WEB APP SUDAH DIMASUKKAN DI SINI
        const GAS_URL = 'https://script.google.com/macros/s/AKfycbwWck98UR0-zc7qXmj9rme0Beb2Oe4afhpYr5HmCS5Cc78XJuzkUASav9r69BXA94g/exec'; 

        const form = document.getElementById('formAbsen');
        const btnSubmit = document.getElementById('btnSubmit');
        const notifikasi = document.getElementById('notifikasi');
        
        const camera = document.getElementById('camera');
        const btnCapture = document.getElementById('btnCapture');
        const preview = document.getElementById('preview');
        const fotoData = document.getElementById('fotoData');
        const lokasiStatus = document.getElementById('lokasiStatus');
        const gpsData = document.getElementById('gpsData');

        let isLocationReady = false;
        let isPhotoReady = false;

        function checkReadyStatus() {
            if (isLocationReady && isPhotoReady) {
                btnSubmit.disabled = false;
                btnSubmit.textContent = 'Kirim Absen';
            }
        }

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    gpsData.value = `https://www.google.com/maps?q=${lat},${lon}`;
                    lokasiStatus.textContent = `Titik didapatkan: ${lat.toFixed(5)}, ${lon.toFixed(5)}`;
                    lokasiStatus.style.backgroundColor = '#d4edda';
                    isLocationReady = true;
                    checkReadyStatus();
                },
                (error) => {
                    lokasiStatus.textContent = 'Gagal akses GPS. Izinkan lokasi di browser.';
                    lokasiStatus.style.backgroundColor = '#f8d7da';
                },
                { enableHighAccuracy: true }
            );
        }

        navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } })
            .then(stream => { camera.srcObject = stream; })
            .catch(error => { notifikasi.textContent = 'Gagal mengakses kamera.'; });

        btnCapture.addEventListener('click', () => {
            const canvas = document.createElement('canvas');
            canvas.width = camera.videoWidth;
            canvas.height = camera.videoHeight;
            const context = canvas.getContext('2d');
            context.drawImage(camera, 0, 0, canvas.width, canvas.height);
            
            const imageData = canvas.toDataURL('image/jpeg', 0.7);
            fotoData.value = imageData;
            preview.src = imageData;
            
            camera.style.display = 'none';
            preview.style.display = 'block';
            btnCapture.textContent = 'Foto Ulang';
            
            isPhotoReady = true;
            checkReadyStatus();

            btnCapture.onclick = function() {
                camera.style.display = 'block';
                preview.style.display = 'none';
                fotoData.value = '';
                btnCapture.textContent = 'Ambil Foto';
                isPhotoReady = false;
                btnSubmit.disabled = true;
            }
        });

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            btnSubmit.disabled = true;
            btnSubmit.textContent = 'Mengunggah data & foto...';
            notifikasi.style.color = 'black';
            notifikasi.textContent = 'Mohon tunggu, proses upload...';

            const payload = {
                tipeAbsen: document.getElementById('tipeAbsen').value,
                nama: document.getElementById('nama').value,
                status: document.getElementById('status').value,
                gps: gpsData.value,
                foto: fotoData.value
            };

            fetch(GAS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if(data.status === "success") {
                    notifikasi.style.color = 'green';
                    notifikasi.textContent = data.message;
                    
                    setTimeout(() => { location.reload(); }, 2500);
                } else {
                    notifikasi.style.color = 'red';
                    notifikasi.textContent = 'Gagal menyimpan absensi.';
                    btnSubmit.disabled = false;
                }
            })
            .catch(error => {
                notifikasi.style.color = 'red';
                notifikasi.textContent = 'Terjadi kesalahan jaringan saat upload.';
                btnSubmit.disabled = false;
                btnSubmit.textContent = 'Coba Kirim Lagi';
            });
        });
    </script>
</body>
</html>
